// The installation Bundle Identifier is set in the PulsePlayer target's Signing & Capabilities.
// Case-sensitive release name registered with getV2.
PULSEPLAYER_RELEASE_NAME = LoopFold
PULSEPLAYER_API_HOST = ghpeoz.pulseplayer.site
// Registered backend identity for packageName and guest login.
PULSEPLAYER_SERVICE_PACKAGE_NAME = app.foldotplayer.loopfold
// Empty expansion preserves // in xcconfig URL values.
PULSEPLAYER_WEBSITE_URL = https:/$()/www.pulseplayer.site/
PULSEPLAYER_PRIVACY_URL = https:/$()/www.pulseplayer.site/privacy.html
PULSEPLAYER_TERMS_URL = https:/$()/www.pulseplayer.site/terms.html
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 2
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
// Production ad units are supplied by getV2.adList.
PULSEPLAYER_ADS_TEST_MODE = NO
PULSEPLAYER_GOOGLE_ADS_APP_ID = ca-app-pub-4423220037289714~1028238991
OTHER_LDFLAGS = $(inherited) -ObjC
